# Copy to .env and fill in your values. Never commit .env.

# Long random string used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Your PostgreSQL database. Tables are created automatically on first start.
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/fairshare

# Optional: "require" to insist on SSL (hosted Postgres). Default "prefer" works for both.
# DB_SSLMODE=prefer
